# Hot Wheels: World's Best Driver (Wii U) - NEX server config.
# Copy to .env and fill in. All names are namespaced PN_HWWBD_*.

# --- PRUDP listeners ---
PN_HWWBD_AUTH_PORT=27600
PN_HWWBD_SECURE_PORT=27601
# Host the client is told to reach the secure server on. MUST be short: the
# retail binary truncates it into a ~15-char buffer.
PN_HWWBD_SECURE_HOST=localhost

# --- Database (ranking only - see RECON.md) ---
PN_HWWBD_POSTGRES_URI=postgres://hwwbd:hwwbd@localhost:5432/hwwbd?sslmode=disable

# --- Kerberos / system accounts ---
PN_HWWBD_KERBEROS_PASSWORD=change-me

# --- Auth mode ----------------------------------------------------------
# 1 = isolated preservation mode: accounts from settings.json, login token
#     not validated. Leave the two NEX_* vars below empty.
PN_HWWBD_LOCAL_MODE=1
PN_HWWBD_SETTINGS_PATH=settings.json

# Required only when PN_HWWBD_LOCAL_MODE is not 1:
PN_HWWBD_NEX_TOKEN_AES_KEY=
PN_HWWBD_NEX_PASSWORD_SECRET=
